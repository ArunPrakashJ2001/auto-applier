# ─────────────────────────────────────────────
#   Auto Applier — Environment Configuration
#   Copy this file to .env and fill in values.
#   NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Google Gemini API
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio (for WhatsApp notifications)
# Get these at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your WhatsApp-enabled phone number (E.164 format, e.g. +14155551234)
MY_PHONE_NUMBER=+1XXXXXXXXXX

# MongoDB
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=auto_applier
